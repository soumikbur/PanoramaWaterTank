// ============================================================
// CALCULATE WATER LEVEL FROM ADC VALUE
// ============================================================
// Converts raw ADC value into physical water level in centimeters using calibrated voltage offset.
float getHeightFromADC(float adcValue)
{
    // Convert ADC value to voltage.
    float voltage = ads.computeVolts(adcValue);

    // Reject reading if voltage indicates sensor disconnection (< 0.25V).
    if (voltage < VOLTAGE_DISCONNECT_THRESHOLD)
    {
        return 0.0f;
    }

    // Compute voltage offset relative to calibrated zero baseline (A_air).
    float zeroVolts = ads.computeVolts(A_air);
    float voltageOffset = voltage - zeroVolts;

    // Return zero if pressure is at or below air baseline.
    if (voltageOffset <= 0.0f)
    {
        return 0.0f;
    }

    // Convert voltage offset to physical water height in cm:
    // (voltage - zeroVolts) / VOLTS_PER_CM
    float height = voltageOffset / VOLTS_PER_CM;

    // Apply 0.5 cm low-level deadband.
    if (height < DEADBAND_THRESHOLD)
        return 0.0f;

    if (height < 0.0f)
        height = 0.0f;

    if (height > SENSOR_FULL_SCALE_HEIGHT_CM)
        height = SENSOR_FULL_SCALE_HEIGHT_CM;

    return height;
}
